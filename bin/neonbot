#!/bin/bash

CONTAINER_NAME="neonbot-app-1"

cd $(dirname "$0")/../

case "$1" in
  "bash")
    docker exec -it $CONTAINER_NAME bash
    ;;
  "start")
    docker compose up -d
    ;;
  "restart")
    docker restart $CONTAINER_NAME
    ;;
  "logs")
    docker logs $CONTAINER_NAME -f
    ;;
  "update")
    git pull
    ;;
  "upgrade")
    docker exec -it $CONTAINER_NAME sh -c "poetry update --without dev"
    ;;
  "rebuild")
    docker compose up -d --build
    ;;
  *)
    echo "Invalid arguments. (bash|start|restart|logs|update|upgrade|rebuild)"
    exit 1
    ;;
esac